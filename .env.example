# Desarrollo local sin Docker: copiar a apps/api/.env
# La ruta de SQLite es relativa a apps/api/prisma/schema.prisma
DATABASE_URL="file:../../../data/credito.db"

# Secreto de demostración. Cambiarlo fuera de un entorno local.
JWT_SECRET="secreto-de-demo-solo-para-desarrollo-local-32+"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS="7"
COOKIE_SECURE="false"
APP_TZ="America/Managua"
PORT="3000"
